{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with badges and social links",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "github": { "type": "string" },
            "twitter": { "type": "string" },
            "linkedin": { "type": "string" },
            "facebook": { "type": "string" }
          }
        },
        "badges": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "displayName", "email"]
    },
    "Activity": {
      "title": "Activity",
      "description": "User activity log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "action", "createdAt"]
    },
    "Form": {
      "title": "Form",
      "description": "Metadata and question structure for a dynamic form (folder)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "description": { "type": "string" },
        "questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "type": { "enum": ["text", "textarea", "number", "date", "select"] },
              "required": { "type": "boolean" },
              "options": { "type": "array", "items": { "type": "string" } },
              "role": { "enum": ["standard", "primary", "prefilled"] }
            }
          }
        },
        "hasDataset": { "type": "boolean" },
        "dataset": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["name", "slug", "questions", "createdAt", "createdBy"]
    },
    "FormResponse": {
      "title": "Form Response",
      "description": "User submitted answers for a specific form",
      "type": "object",
      "properties": {
        "formId": { "type": "string" },
        "formSlug": { "type": "string" },
        "answers": { "type": "object" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["formId", "formSlug", "answers", "submittedAt"]
    },
    "FileMetadata": {
      "title": "File Metadata",
      "description": "Metadata for files uploaded to Firebase Storage",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "path": { "type": "string" },
        "size": { "type": "number" },
        "type": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploadedBy": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["name", "url", "path", "size", "type", "uploadedAt", "userId"]
    },
    "UserAIKey": {
      "title": "User AI Key",
      "description": "Secondary AI API key provided by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "apiKey": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "revoked", "invalid"] }
      },
      "required": ["userId", "apiKey", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Document category",
      "type": "object",
      "properties": {
        "name": { "type": "string" }
      },
      "required": ["name"]
    },
    "Document": {
      "title": "Document",
      "description": "Administrative document metadata",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "note": { "type": "string" },
        "githubUrl": { "type": "string" },
        "githubSha": { "type": "string" },
        "githubPath": { "type": "string" },
        "views": { "type": "number" },
        "downloads": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "categoryId", "githubUrl", "githubPath"]
    },
    "SiteStat": {
      "title": "Site Stat",
      "description": "Visitor statistics for the site",
      "type": "object",
      "properties": {
        "count": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      },
      "required": ["count"]
    },
    "AvatarFrame": {
      "title": "Avatar Frame",
      "description": "Avatar frame event configurations and PNG overlays",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "active": { "type": "boolean" },
        "githubPath": { "type": "string" },
        "githubSha": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "imageUrl", "active"]
    },
    "HrmEmployee": {
      "title": "Hrm Employee",
      "description": "Official store employee personnel record details",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "idCard": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["fullName", "birthDate", "gender", "idCard", "phone"]
    },
    "HrmCollaborator": {
      "title": "Hrm Collaborator",
      "description": "Official store collaborator personnel record details",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "birthDate": { "type": "string" },
        "gender": { "type": "string" },
        "region": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["fullName", "birthDate", "gender", "region", "phone"]
    },
    "GitHubConfig": {
      "title": "GitHub Config",
      "description": "Credentials for GitHub CDN storage",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "owner": { "type": "string" },
        "repo": { "type": "string" }
      },
      "required": ["token", "owner", "repo"]
    },
    "RecurringEvent": {
      "title": "Recurring Event",
      "description": "Calendar recurring events/tasks details",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "enum": ["yearly", "monthly"] },
        "day": { "type": "number" },
        "month": { "type": "number" },
        "importance": { "enum": ["low", "medium", "high"] },
        "description": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "type", "day", "importance"]
    },
    "AiTool": {
      "title": "AI Tool",
      "description": "Store recommended AI tools and services",
      "type": "object",
      "properties": {
        "logoUrl": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url"]
    },
    "WordCover": {
      "title": "Word Cover",
      "description": "Information and download links for Word cover page templates",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "previewUrl": { "type": "string" },
        "docUrl": { "type": "string" },
        "downloadCount": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "previewUrl", "docUrl"]
    },
    "AdminSession": {
      "title": "Admin Session",
      "description": "Session tracking for admin logins to monitor multi-device or IP conflicts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string" },
        "device": { "type": "string" },
        "ip": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "number" },
        "lastActiveAt": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "uid", "email", "device", "ip", "createdAt", "active"]
    },
    "UserWallet": {
      "title": "User Wallet",
      "description": "User balance information",
      "type": "object",
      "properties": {
        "balance": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["balance"]
    },
    "Deposit": {
      "title": "Deposit",
      "description": "Top-up history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "bank": { "type": "string" },
        "accountNumber": { "type": "string" },
        "referenceCode": { "type": "string" },
        "status": { "enum": ["pending", "completed", "expired"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "amount", "status", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Purchase history",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "enum": ["purchase", "refund", "adjustment"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "productName", "amount", "type", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "User saved/bookmarked apps and utilities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "itemId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "enum": ["utility", "app", "page"] },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "itemId", "title", "type", "url"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System or admin-sent notification to users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "target": { "enum": ["all", "user", "role"] },
        "targetValue": { "type": "string" },
        "createdAt": { "type": "number" },
        "senderName": { "type": "string" }
      },
      "required": ["id", "title", "message", "target", "createdAt"]
    },
    "UserReadNotification": {
      "title": "User Read Notification",
      "description": "Marks a notification as read and records reading timestamp",
      "type": "object",
      "properties": {
        "readAt": { "type": "number" }
      },
      "required": ["readAt"]
    },
    "SharedLocation": {
      "title": "Shared Location",
      "description": "User shared location in real-time for Find Nearby utility",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "displayName", "email", "latitude", "longitude", "updatedAt"]
    },
    "NearbyFriendship": {
      "title": "Nearby Friendship",
      "description": "Friendship and request status between users for Find Nearby utility",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "senderId", "receiverId", "status", "createdAt", "updatedAt"]
    },
    "PortalPost": {
      "title": "Portal Post",
      "description": "Posts, announcements, and information articles on the portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "background": { "type": "string" },
        "views": { "type": "number" },
        "shares": { "type": "number" },
        "likes": { "type": "number" },
        "likedBy": { "type": "array", "items": { "type": "string" } },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["title", "summary", "content", "category", "background", "authorId", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "bookmarks": {
      "schema": "Bookmark",
      "description": "User saved/bookmarked items for quick access"
    },
    "notifications": {
      "schema": "Notification",
      "description": "Global and targeted system notification messages"
    },
    "users/{userId}/read_notifications": {
      "schema": "UserReadNotification",
      "description": "Tracks notifications read by specific users"
    },
    "activity_feed": {
      "schema": "Activity",
      "description": "User activity log for real-time feed"
    },
    "user_profiles": {
      "schema": "UserProfile",
      "description": "User profiles with badges and social links"
    },
    "admin_sessions": {
      "schema": "AdminSession",
      "description": "Admin login sessions tracked for real-time security alerts on multi-device or location conflicts"
    },
    "wallets": {
      "schema": "UserWallet",
      "description": "User balances"
    },
    "deposits": {
      "schema": "Deposit",
      "description": "Deposit requests"
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Transaction logs"
    },
    "ai_tools": {
      "schema": "AiTool",
      "description": "Store recommended AI tools and services"
    },
    "forms": {
      "schema": "Form",
      "description": "Store all dynamic forms (folders)"
    },
    "form_responses": {
      "schema": "FormResponse",
      "description": "Store all user responses for forms"
    },
    "stats": {
      "schema": "SiteStat",
      "description": "Global, daily, monthly, and yearly site visitor statistics"
    },
    "files": {
      "schema": "FileMetadata",
      "description": "Store metadata of all uploaded files"
    },
    "user_ai_keys": {
      "schema": "UserAIKey",
      "description": "Stores secondary AI API keys provided by users"
    },
    "document_categories": {
      "schema": "Category",
      "description": "Document storage categories"
    },
    "documents": {
      "schema": "Document",
      "description": "Administrative documents and forms metadata"
    },
    "github_config": {
      "schema": "GitHubConfig",
      "description": "Shared GitHub integration settings"
    },
    "avatar_frames": {
      "schema": "AvatarFrame",
      "description": "Store all custom avatar frames and campaign transparent overlays"
    },
    "hrm_employees": {
      "schema": "HrmEmployee",
      "description": "Official store employee personnel record details"
    },
    "hrm_collaborators": {
      "schema": "HrmCollaborator",
      "description": "Official store collaborator personnel record details"
    },
    "recurring_events": {
      "schema": "RecurringEvent",
      "description": "Store custom recurring tasks of the organization"
    },
    "word_covers": {
      "schema": "WordCover",
      "description": "Metadata for Word cover page templates"
    },
    "shared_locations": {
      "schema": "SharedLocation",
      "description": "Real-time user locations for Find Nearby utility"
    },
    "nearby_friendships": {
      "schema": "NearbyFriendship",
      "description": "Friendships and requests for masking/unmasking PII in Find Nearby"
    },
    "portal_posts": {
      "schema": "PortalPost",
      "description": "Official announcements, informational posts, and articles"
    }
  }
}
