rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'sonlyhongduc@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    // --- Collections ---

    // USERS
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    // Prevent users from changing their own role unless they are admin
                    (isAdmin() || incoming().role == existing().role);
      allow delete: if isAdmin();
    }

    // SETTINGS / SYSTEM
    match /settings/{docId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // NOTIFICATIONS
    match /notifications/{notifyId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn(); // Allow updating read status
      allow create, delete: if isAdmin();
    }

    // PRODUCTS / UTILITIES
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /utilities/{id} { allow read: if true; allow write: if isAdmin(); }
    match /airdrops/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banks/{id} { allow read: if true; allow write: if isAdmin(); }
    match /exchanges/{id} { allow read: if true; allow write: if isAdmin(); }

    // DATA LOGS
    match /device_logins/{id} {
      allow read: if isAdmin();
      allow create: if true; // Allow logging even if not signed in for tracking
      allow delete: if isAdmin();
    }

    match /utility_usage/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /contact_requests/{id} {
      allow read: if isAdmin();
      allow create: if true; 
      allow delete: if isAdmin();
    }
  }
}
