rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email in ['sonlyhongduc@gmail.com', 'cuong.nguyen1@ghn.vn'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['sonlyhongduc@gmail.com', 'cuong.nguyen1@ghn.vn'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin')
      );
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---
    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150;
    }

    function isValidUserAIKey(data) {
      return data.keys().hasAll(['userId', 'apiKey', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.apiKey is string && data.apiKey.size() <= 200 &&
             data.status in ['active', 'revoked', 'invalid'];
    }

    // --- Collections ---

    // USERS
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin()) && 
                    // Prevent users from changing their own role/status unless they are superadmin
                    (isSuperAdmin() || (incoming().get('role', existing().get('role', 'user')) == existing().get('role', 'user') && 
                                       incoming().get('isBanned', existing().get('isBanned', false)) == existing().get('isBanned', false) &&
                                       incoming().get('status', existing().get('status', 'active')) == existing().get('status', 'active')));
      allow delete: if isSuperAdmin();

      match /private/security {
        allow read, write: if isOwner(userId);
      }
    }

    // SETTINGS / SYSTEM
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      // Support nested settings
      match /{allSubcollections=**} {
        allow read: if isAdmin();
        allow write: if isSuperAdmin();
      }
    }

    // USER AI KEYS
    match /user_ai_keys/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidUserAIKey(incoming());
      allow delete: if isAdmin();
    }

    // PRODUCTS / UTILITIES
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /utilities/{id} { allow read: if true; allow write: if isAdmin(); }
    match /airdrops/{id} { allow read: if true; allow write: if isAdmin(); }
    match /banks/{id} { allow read: if true; allow write: if isAdmin(); }
    match /exchanges/{id} { allow read: if true; allow write: if isAdmin(); }

    // DATA LOGS
    match /device_logins/{id} {
      allow read: if isAdmin();
      allow create: if true; // Allow logging even if not signed in for tracking
      allow delete: if isAdmin();
    }

    match /utility_usage/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /contact_requests/{id} {
      allow read: if isAdmin();
      allow create: if true; 
      allow delete: if isAdmin();
    }

    match /activities/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /blockedIps/{ip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // APPS & CATEGORIES
    match /apps/{appId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ADMIN REQUESTS
    match /adminRequests/{reqId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == reqId;
      allow delete: if isSuperAdmin();
    }
    
    // ACTIVITY LOGS
    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isSuperAdmin();
    }
    
    // FILES
    match /files/{fileId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // FORMS & FOLDERS
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /form_responses/{responseId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
