rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global lock for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins logic
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'sonlyhongduc@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin']
      );
    }
    
    // Auth validation
    function isAuthenticated() {
      return request.auth != null;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if request.auth.uid == userId;
      // Allow users to update their own profile, or admins to update anyone
      allow update: if request.auth.uid == userId || isAdmin();
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // TASKS COLLECTION
    match /tasks/{taskId} {
      // Users can only read their own tasks, or it's a group task
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.type == 'group' || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // SETTINGS COLLECTION (Maintenance Mode)
    match /settings/{docId} {
      // Anyone logged in can read settings (for maintenance check)
      // Allow unauthenticated reads for settings so people hitting the login page know about maintenance Mode
      allow read: if true; 
      // Only admin can modify system settings
      allow write: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notifyId} {
      // Anyone authenticated can read global notifications
      allow read: if isAuthenticated();
      // Anyone can update the readBy array (requires field restriction ideally)
      allow update: if isAuthenticated();
      // Only admin can publish/delete global notifications
      allow create, delete: if isAdmin();
    }

    // SHARED FILES COLLECTION
    match /sharedFiles/{fileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // SITE CONFIGS
    match /siteConfigs/{configId} {
      allow read: if true; // Public profiles are readable
      allow write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }

    // DNS REQUESTS
    match /dnsRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // SUBDOMAIN REQUESTS
    match /subdomainRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending' &&
                    request.resource.data.subdomain is string &&
                    request.resource.data.subdomain.size() >= 3 &&
                    request.resource.data.subdomain.size() <= 32;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
